# Base64-encoded account_id:personal_access_token. See README.md for required scopes.
TEXT_BASIC_AUTH=

# Use a long random value, for example: openssl rand -hex 32
TEXT_WEBHOOK_SECRET=

# HubSpot private app access token with contact read/write scopes.
HUBSPOT_ACCESS_TOKEN=

# Optional JSON map: Text customer-property name to HubSpot contact-property internal name.
# TEXT_TO_HUBSPOT_PROPERTY_MAP='{"Company Size":"company_size","Account ID":"text_account_id"}'
TEXT_TO_HUBSPOT_PROPERTY_MAP=

# Required only when registering the Text webhook with the README command.
TEXT_OWNER_CLIENT_ID=
WEBHOOK_PUBLIC_URL=https://replace-with-your-public-https-url

# Optional local host port for Docker Compose.
HOST_PORT=8080
